# Copy this file to .env and fill in values. .env is gitignored.

# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-random-secret-key

DEBUG=True

# Comma-separated list, e.g. yourdomain.com,api.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset to use local SQLite. Set to a Postgres URL (Supabase/Neon) in production:
# DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=

# Comma-separated list of frontend origins allowed to call this API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave all three blank to store uploads (project thumbnails, resume) on local disk.
# Set all three (from your Cloudinary dashboard) to store them on Cloudinary instead —
# required for uploads to survive redeploys on free-tier hosts with ephemeral disks.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
